# ---- Deployment-Variante (Overlay wählen) -------------------------------------
# Homelab (LAN/VPN, DNS-01):
COMPOSE_FILE=docker-compose.yml:deploy/compose.traefik.yml
# Oracle/öffentlich (HTTP-01):
# COMPOSE_FILE=docker-compose.yml:deploy/compose.caddy.yml

# ---- Pflicht ----------------------------------------------------------------
API_DOMAIN=kochplan.lab.syltwerk.de
POSTGRES_PASSWORD=            # openssl rand -base64 32
JWT_SECRET=                   # openssl rand -base64 48

# MVP im Homelab: dev ist ok (Swagger unter /docs, Dev-Login für erste Tests),
# solange der Server nur per LAN/VPN erreichbar ist. Öffentlich: prod + false.
ENV=dev
DEV_LOGIN_ENABLED=true

# ---- Nur Traefik/Homelab ------------------------------------------------------
ACME_EMAIL=
DNS_PROVIDER=ionos            # lego-Provider-Code, z. B. ionos, cloudflare, hetzner, inwx
                              # Credentials gehören in .env.dns (siehe .env.dns.example)

# ---- Sign in with Apple / Google (Listen als JSON) ---------------------------
APPLE_AUDIENCES=["de.syltwerk.kochplan"]                 # Bundle-ID (+ Services-ID für Web)
GOOGLE_AUDIENCES=["xxxx.apps.googleusercontent.com"]     # iOS- und Web-Client-ID

CORS_ORIGINS=["http://localhost:5173"]

# ---- KI ---------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PRICE_INPUT_PER_MTOK_USD=3.0      # mit aktueller Preisliste abgleichen
AI_PRICE_OUTPUT_PER_MTOK_USD=15.0
AI_LIMITS_ENABLED=false              # MVP: false · Production: true
AI_RATE_PER_MINUTE=10
AI_MAX_PER_PLAN=7

DEFAULT_TIMEZONE=Europe/Berlin
START_BUFFER_MINUTES=10
