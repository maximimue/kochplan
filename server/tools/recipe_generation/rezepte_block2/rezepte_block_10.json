    {"id":"B10-036","titel":"Schinken-Brokkoli-Pfanne mit Ei","portionen":2,"dauer_min":20,"protein_g":30,"fett_g":16,"kh_g":12,"kcal":300,"geraete":["Pfanne"],"allergene":["Ei","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["250 g Brokkoli","100 g Kochschinken","2 Eier","50 ml Sahne","1 EL Butter","50 g Gouda (45 %)","Pfeffer, Muskat"],"schritte":"Brokkoli in Butter 5 Min. braten, Schinkenwürfel zugeben. Eier mit Sahne und Gewürzen verquirlen, darübergießen und stocken lassen. Mit Käse bestreuen."},
