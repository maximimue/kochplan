    {"id":"B8-041","titel":"Hähnchen-Teriyaki-Spieße","portionen":3,"dauer_min":25,"protein_g":42,"fett_g":10,"kh_g":30,"kcal":370,"geraete":["Backofen"],"allergene":["Soja (Sojasauce)","Gluten (Sojasauce)","Sesam"],"quelle":"fest","einschraenkungen":false,"zutaten":["500 g Hähnchenbrust","3 EL Sojasauce","1 EL Honig","1 EL Reisessig","1 Knoblauchzehe","1 Paprika","1 Zucchini","Sesam"],"schritte":"Hähnchen würfeln und mit Sojasauce, Honig, Essig und Knoblauch 20 Min. marinieren. Mit Gemüse auf Spieße stecken, 15 Min. bei 200 °C grillen und mit Sesam bestreuen."},
    {"id":"B8-042","titel":"Lachs-Schnitte mit Frischkäse","portionen":1,"dauer_min":10,"protein_g":36,"fett_g":16,"kh_g":35,"kcal":420,"geraete":[],"allergene":["Fisch","Gluten","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["2 Scheiben Vollkornbrot","100 g Räucherlachs","80 g Frischkäse (light)","1/2 Gurke","Dill, Pfeffer"],"schritte":"Brot mit Frischkäse bestreichen, Lachs und Gurkenscheiben darauflegen und mit Dill und Pfeffer abschmecken."},
    {"id":"B8-043","titel":"Rinderbraten-Sandwich mit Meerrettich","portionen":2,"dauer_min":15,"protein_g":40,"fett_g":14,"kh_g":40,"kcal":460,"geraete":[],"allergene":["Gluten","Milch","Senf"],"quelle":"fest","einschraenkungen":false,"zutaten":["200 g Rinderbraten (aufschnitt)","2 Ciabatta-Brötchen","50 g Frischkäse (light)","1 TL Meerrettich","Rucola","1 Tomate","Salz, Pfeffer"],"schritte":"Brötchen aufschneiden. Frischkäse mit Meerrettich verrühren und auf die Brötchen streichen. Mit Fleisch, Rucola und Tomate belegen."},
    {"id":"B8-044","titel":"Hähnchen-Mango-Curry","portionen":3,"dauer_min":30,"protein_g":40,"fett_g":16,"kh_g":40,"kcal":450,"geraete":["Pfanne"],"allergene":["Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["450 g Hähnchenbrust","1 Mango","200 ml Kokosmilch","1 Zwiebel","2 TL Currypulver","150 g Reis","100 g Joghurt (3,5 %)","Koriander, Salz"],"schritte":"Hähnchen in Würfeln mit Zwiebel und Curry anbraten. Kokosmilch und halbe Mango zugeben, 12 Min. köcheln. Restliche Mango in Stücken und Joghurt unterrühren. Mit Reis und Koriander servieren."},
    {"id":"B8-045","titel":"Kabeljau-Spinat-Auflauf mit Sahne","portionen":4,"dauer_min":40,"protein_g":38,"fett_g":16,"kh_g":12,"kcal":330,"geraete":["Backofen"],"allergene":["Fisch","Milch","Ei"],"quelle":"fest","einschraenkungen":false,"zutaten":["500 g Kabeljaufilet","300 g Blattspinat","150 ml Sahne","2 Eier","1 Knoblauchzehe","80 g Gouda (45 %)","1 TL Zitronenabrieb","Muskat, Salz, Pfeffer"],"schritte":"Spinat mit Knoblauch zusammenfallen lassen und in eine Form geben. Kabeljau salzen und darauflegen. Sahne mit Eiern, Zitronenabrieb und Muskat verquirlen, darübergießen, mit Käse bestreuen und 25 Min. bei 190 °C backen."},
