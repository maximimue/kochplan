    {"id":"B8-035","titel":"Lachs-Burger mit Vollkornbrötchen","portionen":2,"dauer_min":25,"protein_g":40,"fett_g":18,"kh_g":40,"kcal":500,"geraete":["Pfanne"],"allergene":["Fisch","Gluten","Ei","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["300 g Lachsfilet","1 Ei","2 EL Semmelbrösel","2 Vollkornbrötchen","100 g Frischkäse (light)","Gurke, Tomate, Salat","1 TL Dill","Zitrone, Salz"],"schritte":"Lachs fein hacken, mit Ei, Bröseln und Dill mischen, zu Patties formen und in Öl braten. Brötchen mit Frischkäse, Gemüse und Patty belegen und mit Zitrone beträufeln."},
    {"id":"B8-036","titel":"Rindfleisch-Eintopf mit Kartoffeln","portionen":4,"dauer_min":90,"protein_g":40,"fett_g":14,"kh_g":35,"kcal":430,"geraete":["Herd"],"allergene":[],"quelle":"fest","einschraenkungen":false,"zutaten":["600 g Rindfleisch (Wade)","500 g Kartoffeln","2 Karotten","1 Zwiebel","2 EL Tomatenmark","1 l Rinderbrühe","1 Lorbeerblatt","Majoran, Salz, Pfeffer"],"schritte":"Fleisch mit Zwiebel in Öl anbraten, Tomatenmark mitrösten. Mit Brühe ablöschen, Lorbeer zugeben und 60 Min. schmoren. Kartoffeln und Karotten zugeben und weitere 20 Min. garen. Mit Majoran abschmecken."},
    {"id":"B8-037","titel":"Garnelen-Linguine mit Knoblauch","portionen":3,"dauer_min":20,"protein_g":36,"fett_g":14,"kh_g":55,"kcal":480,"geraete":["Herd","Pfanne"],"allergene":["Gluten","Schalentiere"],"quelle":"fest","einschraenkungen":false,"zutaten":["300 g Linguine","300 g Garnelen","4 Knoblauchzehen","1 Chili","2 EL Olivenöl","100 ml Weißwein","Petersilie, Zitrone, Salz"],"schritte":"Linguine kochen. Knoblauch und Chili in Öl anbraten, Garnelen 3 Min. braten, mit Wein ablöschen. Nudeln zugeben, mit Petersilie und Zitrone vermengen."},
    {"id":"B8-038","titel":"Hähnchen-Burrito mit Vollkorntortilla","portionen":2,"dauer_min":25,"protein_g":42,"fett_g":16,"kh_g":50,"kcal":500,"geraete":["Pfanne"],"allergene":["Gluten","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["350 g Hähnchenbrust","2 Vollkorntortillas","150 g Kidneybohnen (abgetropft)","100 g Reis (gegart)","1 Paprika","100 g Käse (Gouda, 45 %)","1 Avocado","Salsa, Salat"],"schritte":"Hähnchen mit Paprika in Streifen braten und würzen. Tortillas mit Reis, Bohnen, Hähnchen, Avocado, Käse und Salsa füllen und einrollen. Kurz in der Pfanne anrösten."},
