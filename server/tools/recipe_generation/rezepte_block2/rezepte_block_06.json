    {"id":"B6-037","titel":"Kabeljau-Gratin mit Kartoffeln","portionen":3,"dauer_min":45,"protein_g":36,"fett_g":16,"kh_g":35,"kcal":400,"geraete":["Backofen"],"allergene":["Fisch","Milch","Ei"],"quelle":"fest","einschraenkungen":false,"zutaten":["400 g Kabeljaufilet","500 g Kartoffeln","200 ml Sahne","2 Eier","80 g Gouda (45 %)","1 Zwiebel","1 TL Dill","Salz, Muskat"],"schritte":"Kartoffeln in Scheiben schichten, Kabeljau in Stücken und Zwiebel darauf verteilen. Sahne mit Eiern, Dill und Muskat verquirlen, darübergießen, Käse aufstreuen und 35 Min. bei 180 °C backen."},
    {"id":"B6-038","titel":"Schinken-Eier-Muffins","portionen":6,"dauer_min":25,"protein_g":22,"fett_g":16,"kh_g":4,"kcal":240,"geraete":["Backofen"],"allergene":["Ei","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["6 Eier","100 g Kochschinken","80 g Emmentaler","100 g Blattspinat","4 EL Sahne","Schnittlauch, Pfeffer, Salz"],"schritte":"Schinken und Spinat in Muffinförmchen verteilen. Eier mit Sahne und Gewürzen verquirlen, darübergießen, Käse aufstreuen und 18 Min. bei 180 °C backen."},
    {"id":"B6-039","titel":"Hähnchen-Wings aus dem Ofen","portionen":3,"dauer_min":50,"protein_g":45,"fett_g":22,"kh_g":8,"kcal":400,"geraete":["Backofen"],"allergene":[],"quelle":"fest","einschraenkungen":false,"zutaten":["1 kg Hähnchenflügel","2 EL Olivenöl","1 TL Paprikapulver","1 TL Knoblauchpulver","1 TL Backpulver","Salz, Pfeffer","Paprika-Dip (Joghurt)"],"schritte":"Flügel trocken tupfen, mit Backpulver und Gewürzen bestreuen. Auf einem Gitter 45 Min. bei 200 °C backen, bis sie knusprig sind. Mit Joghurt-Dip servieren."},
    {"id":"B6-040","titel":"Garnelen-Cocktail mit Vollkornbrot","portionen":2,"dauer_min":15,"protein_g":36,"fett_g":12,"kh_g":35,"kcal":380,"geraete":["Herd"],"allergene":["Schalentiere","Gluten","Ei"],"quelle":"fest","einschraenkungen":false,"zutaten":["300 g Garnelen (gekocht)","2 Scheiben Vollkornbrot","1 Ei","2 EL Ketchup","1 EL Joghurt (10 %)","1 TL Meerrettich","1 Zitrone","Salatherzen"],"schritte":"Ei 9 Min. kochen. Ketchup, Joghurt, Meerrettich und Zitrone zu einer Sauce mischen. Garnelen und Salat anrichten, Sauce darübergeben und mit Ei und Brot servieren."},
    {"id":"B6-041","titel":"Rindersteak mit Pfeffersauce","portionen":2,"dauer_min":25,"protein_g":45,"fett_g":24,"kh_g":12,"kcal":460,"geraete":["Pfanne"],"allergene":["Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["2 Rinderlendensteaks (je 200 g)","150 g Schmand","1 EL grüner Pfeffer (eingelegt)","100 ml Rinderbrühe","1 TL Dijon-Senf","1 EL Olivenöl","Salz, Thymian","200 g Brokkoli"],"schritte":"Steaks salzen und in Öl scharf anbraten, ruhen lassen. Brühe mit Schmand, Pfeffer und Senf aufkochen. Brokkoli blanchieren und zum Steak servieren."},
    {"id":"B6-042","titel":"Gyros-Pita mit Hähnchen","portionen":2,"dauer_min":25,"protein_g":42,"fett_g":14,"kh_g":45,"kcal":480,"geraete":["Pfanne"],"allergene":["Gluten","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["350 g Hähnchenbrust","2 Pita-Brote","1 Tomate","1/2 rote Zwiebel","100 g Quark (20 %)","1/2 Gurke","Oregano, Paprikapulver, Knoblauch","1 EL Olivenöl"],"schritte":"Hähnchen in Streifen mit Gewürzen in Öl braten. Quark mit geriebener Gurke und Knoblauch zu Tzatziki rühren. Pita füllen mit Hähnchen, Tomate, Zwiebel und Tzatziki."},
    {"id":"B6-043","titel":"Hähnchen-Bruschetta auf Vollkornbrot","portionen":2,"dauer_min":20,"protein_g":40,"fett_g":14,"kh_g":35,"kcal":420,"geraete":["Pfanne","Backofen"],"allergene":["Gluten"],"quelle":"fest","einschraenkungen":false,"zutaten":["2 Scheiben Vollkornbrot","300 g Hähnchenbrust","2 Tomaten","1 Knoblauchzehe","Basilikum","1 EL Olivenöl","Balsamico, Salz"],"schritte":"Hähnchen würzen und in Öl braten. Brot toasten und mit Knoblauch einreiben. Tomaten würfeln und mit Basilikum, Balsamico und Salz mischen. Hähnchen in Scheiben auf das Brot legen und Tomaten darauf verteilen."},
    {"id":"B6-044","titel":"Entenbrust mit Orangen-Rotkohl","portionen":2,"dauer_min":40,"protein_g":40,"fett_g":28,"kh_g":25,"kcal":500,"geraete":["Pfanne","Backofen"],"allergene":[],"quelle":"fest","einschraenkungen":false,"zutaten":["2 Entenbrüste (je 200 g)","300 g Rotkohl (fertig)","1 Orange","1 EL Honig","1 EL Essig","1 Apfel","Thymian, Salz, Pfeffer"],"schritte":"Entenhaut einritzen, ohne Öl auf der Hautseite knusprig braten, dann 8 Min. bei 180 °C garen. Rotkohl mit Orangensaft, Honig, Essig und Apfel 10 Min. schmoren. Mit Entenbrust anrichten."},
    {"id":"B6-045","titel":"Lachs-Frikadellen mit Dill-Joghurt","portionen":3,"dauer_min":25,"protein_g":34,"fett_g":14,"kh_g":18,"kcal":340,"geraete":["Pfanne"],"allergene":["Fisch","Ei","Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["400 g Lachsfilet","1 Ei","2 EL Semmelbrösel","1 Frühlingszwiebel","Dill","150 g Joghurt (10 %)","1 TL Senf","2 EL Olivenöl"],"schritte":"Lachs fein hacken, mit Ei, Bröseln, Frühlingszwiebel und Dill mischen. Zu Frikadellen formen und in Öl braten. Joghurt mit Senf und Dill als Dip reichen."},
    {"id":"B6-046","titel":"Putenbraten mit Ofenkartoffeln","portionen":4,"dauer_min":70,"protein_g":45,"fett_g":14,"kh_g":40,"kcal":420,"geraete":["Backofen"],"allergene":[],"quelle":"fest","einschraenkungen":false,"zutaten":["800 g Putenbraten","800 g Kartoffeln","2 EL Olivenöl","1 TL Rosmarin","1 TL Paprikapulver","300 ml Gemüsebrühe","1 Zwiebel","Salz, Pfeffer"],"schritte":"Braten würzen und mit Zwiebel in den Bräter legen, Brühe zugießen. 60 Min. bei 180 °C garen. Kartoffeln mit Öl und Rosmarin im Ofen dazu rösten und den Bratensaft als Sauce servieren."},
    {"id":"B6-047","titel":"Rindfleisch-Pho mit Reisnudeln","portionen":3,"dauer_min":60,"protein_g":36,"fett_g":12,"kh_g":50,"kcal":420,"geraete":["Herd"],"allergene":["Soja (Sojasauce)","Fisch (Fischsauce)"],"quelle":"fest","einschraenkungen":false,"zutaten":["400 g Rinderfilet (dünn geschnitten)","200 g Reisnudeln","1,5 l Rinderbrühe","1 Stück Ingwer","2 Sternanis","1 Zimtstange","2 EL Fischsauce","Sprossen, Basilikum, Limette"],"schritte":"Brühe mit Ingwer, Sternanis und Zimt 30 Min. aufkochen und würzen. Reisnudeln kochen. Rindfleisch roh in die Schüsseln legen, Nudeln darauf, heiße Brühe darübergießen und mit Sprossen, Basilikum und Limette servieren."},
    {"id":"B6-048","titel":"Hähnchen-Eintopf mit Erbsen","portionen":4,"dauer_min":40,"protein_g":40,"fett_g":10,"kh_g":35,"kcal":380,"geraete":["Herd"],"allergene":[],"quelle":"fest","einschraenkungen":false,"zutaten":["600 g Hähnchenbrust","2 Karotten","2 Kartoffeln","1 Stange Lauch","200 g TK-Erbsen","1 l Hühnerbrühe","1 Lorbeerblatt","Petersilie, Salz, Pfeffer"],"schritte":"Hähnchen in Brühe mit Lorbeer 15 Min. garen. Gemüse und Kartoffeln zugeben und weitere 15 Min. köcheln. Hähnchen zerkleinern, Erbsen 3 Min. mitgaren und mit Petersilie servieren."},
    {"id":"B6-049","titel":"Tomatenreis mit Hackfleisch","portionen":3,"dauer_min":30,"protein_g":36,"fett_g":14,"kh_g":55,"kcal":460,"geraete":["Pfanne"],"allergene":["Milch"],"quelle":"fest","einschraenkungen":false,"zutaten":["400 g Rinderhack","200 g Reis","400 g passierte Tomaten","1 Zwiebel","1 Paprika","300 ml Gemüsebrühe","1 TL Paprikapulver","50 g Gouda (45 %)"],"schritte":"Hack mit Zwiebel und Paprika anbraten. Reis zugeben, mit Tomaten und Brühe ablöschen und 20 Min. köcheln. Mit Gewürzen abschmecken und mit Käse bestreut servieren."},
    {"id":"B6-050","titel":"Kaiserschmarrn mit Quark und Beeren","portionen":2,"dauer_min":25,"protein_g":28,"fett_g":16,"kh_g":55,"kcal":460,"geraete":["Pfanne"],"allergene":["Ei","Milch","Gluten (Mehl)"],"quelle":"fest","einschraenkungen":false,"zutaten":["3 Eier","150 ml Milch","80 g Mehl","1 EL Zucker","1 EL Butter","150 g Quark (20 %)","150 g Beeren","Puderzucker"],"schritte":"Eier, Milch, Mehl und Zucker zu einem Teig verrühren. In Butter in der Pfanne anbraten, zerreißen und karamellisieren. Mit Quark, Beeren und Puderzucker servieren."}
